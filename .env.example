# Copiá este archivo a ".env" (sin ".example") y completá tus claves.
# El ".env" real está en .gitignore: nunca se sube al repositorio.

# --- Pinecone (gratis en https://app.pinecone.io -> API Keys) ---
PINECONE_API_KEY=
INDEX_NAME=python-docs-rag
PINECONE_NAMESPACE=python-stdlib-es
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Embeddings (1536 dimensiones) ---
# "google" -> gemini-embedding-001 (tier gratuito: https://aistudio.google.com/apikey)
# "openai" -> text-embedding-3-small (https://platform.openai.com/api-keys)
EMBEDDING_PROVIDER=google
GOOGLE_API_KEY=
OPENAI_API_KEY=

# --- Opcional: pesos de la fusión RRF [BM25, vectorial] ---
# BM25_WEIGHT=0.5
# VECTOR_WEIGHT=0.5
